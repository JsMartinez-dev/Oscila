# Copia estas variables a .env.local, un archivo excluido de Git.
# Clave privada para la función de reconocimiento. Solo se usa en el servidor.
GEMINI_API_KEY=
# Opcional: modelo de visión (por defecto gemini-3.5-flash-lite)
GEMINI_MODEL=

# Opcional: valores públicos del proyecto de Supabase para habilitar las cuentas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Activa el botón solo después de configurar y verificar Google en Supabase.
VITE_AUTH_GOOGLE=false
# SMTP y el secreto OAuth se configuran en Supabase, nunca en variables VITE_.
